{{! Sheet Header }}
<header class='sheet-header'>
  {{! The portrait, with the Crawler Killer skulls (one per other crawler killed) overlaid on its upper left corner }}
  <div class='portrait'>
    <img
      class='profile-img'
      src='{{actor.img}}'
      data-edit='img'
      data-action='onEditImage'
      data-tooltip='{{actor.name}}'
      height='100'
      width='100'
    />
    {{#if killBadge}}
      <span class='kill-skulls' data-tooltip='{{localize "CARL_RPG.Kills.Tooltip" count=skulls.count}}'>
        {{#each skulls.icons}}<i class='fas fa-skull'></i>{{/each}}
        {{#if skulls.overflow}}<span class='skull-count'>&times;{{skulls.count}}</span>{{/if}}
        {{#each stars.icons}}<i class='fas fa-star'></i>{{/each}}
        {{#if stars.overflow}}<span class='skull-count'>&times;{{stars.count}}</span>{{/if}}
      </span>
    {{/if}}
  </div>
  <div class='header-fields'>
    <div class='document-name flexrow'>
      <input
        name='name'
        type='text'
        value='{{actor.name}}'
        placeholder='Name'
      />
      {{#if (eq actor.type 'crawler')}}
        {{! The box shows "Crawler #" and the number together; the number can be changed in edit mode }}
        <label class='crawler-number' data-tooltip='{{localize "CARL_RPG.Actor.Crawler.Header.CrawlerNumber"}}'>
          <span>{{localize 'CARL_RPG.Actor.Crawler.Header.CrawlerNumber'}}</span>
          <input
            name='system.crawlerNumber'
            type='number'
            value='{{system.crawlerNumber}}'
            min='0'
            step='1'
            data-dtype='Number'
          />
        </label>
        <input
          name='system.gender'
          type='text'
          value='{{actor.system.gender}}'
          placeholder='Gender/Pronouns'
        />
      {{else if (eq actor.type 'pet')}}
        {{! A pet's owner: one of the crawlers, picked from a menu }}
        <select name='system.owner' class='pet-owner' data-tooltip='{{localize "CARL_RPG.Pets.Owner"}}'>
          {{selectOptions ownerOptions selected=system.owner blank=(localize 'CARL_RPG.Pets.NoOwner')}}
        </select>
      {{else}}
        {{! A mob's race is typed in beside its name, followed by what kind of mob it is }}
        <input
          name='system.race'
          type='text'
          value='{{actor.system.race}}'
          placeholder='Race'
        />
        <select name='system.mobType' data-tooltip='{{localize "CARL_RPG.MobTypes.Label"}}'>
          {{selectOptions config.mobTypes selected=system.mobType localize=true}}
        </select>
      {{/if}}
      {{#if (eq actor.type 'mob')}}{{#if editable}}
  <div class='drop-target reward-drop' data-accept='lootBox' data-field='rewardBox' data-tooltip='{{localize "CARL_RPG.Combat.RewardDrop"}}'>
    {{#if hasReward}}
    <span class='drop-name'>{{localize 'CARL_RPG.Combat.RewardSet'}}</span>
    <a class='item-control' data-action='clearReward'><i class='fas fa-xmark'></i></a>
    {{else}}
    <span class='drop-hint'>{{localize 'CARL_RPG.Combat.RewardDrop'}}</span>
    {{/if}}
  </div>
{{/if}}{{/if}}
{{#if canGiveReward}}<button type='button' data-action='giveReward'>{{localize 'CARL_RPG.Combat.GiveReward'}}</button>{{/if}}
{{#if canGiveStar}}<button type='button' data-action='giveStar'>{{localize 'CARL_RPG.Combat.GiveStar'}}</button>{{/if}}
  {{#if canLoot}}<button type='button' data-action='lootMob'>{{localize 'CARL_RPG.Loot.LootMob'}}</button>{{/if}}
{{! Small rest buttons: a crawler (or pet) takes their own rests (short, long, full) }}
      {{#if (ne actor.type 'mob')}}{{#if editable}}
        <span class='rest-buttons-mini'>
          <a draggable='true' data-carl-macro='rest:short' data-action='rest' data-rest='short' data-tooltip='{{localize "CARL_RPG.Rest.Name.short"}}'><i class='fas fa-mug-hot'></i></a>
          <a draggable='true' data-carl-macro='rest:long' data-action='rest' data-rest='long' data-tooltip='{{localize "CARL_RPG.Rest.Name.long"}}'><i class='fas fa-bed'></i></a>
          <a draggable='true' data-carl-macro='rest:full' data-action='rest' data-rest='full' data-tooltip='{{localize "CARL_RPG.Rest.Name.full"}}'><i class='fas fa-moon'></i></a>
        </span>
      {{/if}}{{/if}}
      {{#if editable}}
        <a
          class='edit-toggle {{#if editMode}}active{{/if}}'
          data-action='toggleEditMode'
          data-tooltip='{{#if editMode}}{{localize "CARL_RPG.Sheet.EditOn"}}{{else}}{{localize "CARL_RPG.Sheet.EditOff"}}{{/if}}'
        >
          <i class='fas {{#if editMode}}fa-lock-open{{else}}fa-lock{{/if}}'></i>
        </a>
      {{/if}}
    </div>
    {{! Create Character and Choose Race / Class: buttons on a line of their own under the name row, shown only while they are needed }}
    {{#if hasHeaderActions}}
      <div class='header-actions'>
        {{#if canRevive}}
          <button type='button' data-action='revive'>
            <i class='fas fa-heart-pulse'></i> {{localize 'CARL_RPG.Combat.Revive'}}
          </button>
        {{/if}}
        {{#if creationPending}}
          <button type='button' data-action='createCharacter'>
            <i class='fas fa-user-plus'></i> {{localize 'CARL_RPG.Creation.Create'}}
          </button>
        {{/if}}
        {{! A crawler's race and class come from the race and class items they choose (not typed in) }}
        {{#if originPrompt}}
          <button type='button' data-action='{{originAction}}'>
            <i class='fas fa-dna'></i> {{localize originPrompt}}
          </button>
        {{/if}}
        {{! Skills to pick or points to split that a race, class or effect left to the player }}
        {{#if picksPending}}
          <button type='button' data-action='makeChoices'>
            <i class='fas fa-list-check'></i> {{localize 'CARL_RPG.Picks.MakeChoices'}}
          </button>
        {{/if}}
        {{#if canReassign}}
          <button type='button' data-action='reassignPoints'>
            <i class='fas fa-arrows-rotate'></i> {{localize 'CARL_RPG.Picks.Reassign'}}
          </button>
        {{/if}}
      </div>
    {{/if}}
    {{#if (eq actor.type 'crawler')}}
      {{! The row has a column for each box it shows: Race and Class are hidden while empty outside edit mode, Crawler kills only shows in edit mode, and the row is left out when it has no boxes }}
      {{#if identityCount}}
      <div class='identity grid {{identityGrid}}'>
        {{! A crawler's race and class come from the race and class items they choose (not typed in). An Earth-Based one shows the earth icon inside its box. }}
        {{#if showRace}}
        <div class='icon-field {{#if raceEarthBased}}has-icon{{/if}}'>
          {{#if raceEarthBased}}
            <i class='fas fa-earth-americas race-earth' data-tooltip='{{localize "CARL_RPG.Origin.EarthBased"}}'></i>
          {{/if}}
          <input
            name='system.race'
            type='text'
            value='{{actor.system.race}}'
            placeholder='{{localize "CARL_RPG.Actor.Crawler.Header.Race"}}'
            data-tooltip='{{localize "CARL_RPG.Actor.Crawler.Header.Race"}}'
            disabled='true'
          />
        </div>
        {{/if}}
        {{#if showClass}}
        <div class='icon-field {{#if classEarthBased}}has-icon{{/if}}'>
          {{#if classEarthBased}}
            <i class='fas fa-earth-americas race-earth' data-tooltip='{{localize "CARL_RPG.Origin.EarthBased"}}'></i>
          {{/if}}
          <input
            name='system.className'
            type='text'
            value='{{classDisplay}}'
            placeholder='{{localize "CARL_RPG.Actor.Crawler.Header.Class"}}'
            {{#unless subclassName}}data-tooltip='{{localize "CARL_RPG.Actor.Crawler.Header.Class"}}'{{/unless}}
            disabled='true'
          />
        </div>
        {{/if}}
        {{! How many other crawlers this crawler has killed (shown as skulls by its name); editable in edit mode }}
        {{#if editMode}}
          <label class='crawler-number kills-number' data-tooltip='{{localize "CARL_RPG.Kills.Label"}}'>
            <span>{{localize 'CARL_RPG.Kills.Label'}}</span>
            <input
              name='system.crawlerKills'
              type='number'
              value='{{system.crawlerKills}}'
              min='0'
              step='1'
              data-dtype='Number'
            />
          </label>
        {{/if}}
        {{#if starsEditable}}
          <label class='crawler-number kills-number' data-tooltip='{{localize "CARL_RPG.Combat.BossStars"}}'>
            <span>{{localize 'CARL_RPG.Combat.BossStars'}}</span>
            <input name='system.bossKills' type='number' value='{{system.bossKills}}' min='0' step='1' data-dtype='Number' />
          </label>
        {{/if}}
        {{#if showDeity}}
          <div class='crawler-deity' data-tooltip='{{localize "CARL_RPG.Actor.Crawler.Header.Deity"}}'>
            <span class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Header.Deity'}}</span>
            <span>{{deityName}}</span>
          </div>
        {{/if}}
      </div>
      {{/if}}
    {{/if}}
    {{#if healthBoxes}}
      {{! Health bar: crawlers have 10 boxes (each worth the CON modifier in damage); mobs have a settable number }}
      <div class='health-bar'>
        <div class='health-bar-top'>
          <span class='resource-label'>
            {{localize 'CARL_RPG.Actor.base.FIELDS.health.value.label'}}
          </span>
          {{#if (eq actor.type 'mob')}}
            <label class='health-box-count'>
              {{localize 'CARL_RPG.Actor.Mob.Header.Boxes'}}
              <input
                type='number'
                name='system.health.max'
                value='{{system.health.baseMax}}'
                min='1'
                max='100'
                step='1'
              />
            </label>
          {{/if}}
        </div>
        <div
          class='health-boxes'
          style='grid-template-columns: repeat({{healthColumns}}, minmax(0, 1fr));'
        >
          {{#each healthBoxes}}
            <div class='health-cell'>
              <a
                class='health-box {{#if filled}}filled{{/if}}'
                data-action='setHealth'
                data-value='{{value}}'
                style='background-size: {{bgSize}}% 100%; background-position: {{bgPos}}% 0;'
              >{{label}}</a>
              <span class='health-pct'>{{percent}}</span>
            </div>
          {{/each}}
        </div>
      </div>
    {{/if}}
    {{! The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  }}
    <div class='resources grid {{resourceGrid}}'>

      {{#if (ne actor.type 'mob')}}
        {{! Crawlers and pets: Mana (current / max) and Level, as on the sheet }}
        <div class='resource flex-group-center'>
          <label for='system.mana.value' class='resource-label'>
            {{localize 'CARL_RPG.Actor.Crawler.FIELDS.mana.label'}}
          </label>
          <div class='resource-content flexrow flex-center flex-between'>
            <input
              type='text'
              name='system.mana.value'
              value='{{system.mana.value}}'
              data-dtype='Number'
            />
            <span> / </span>
            {{! The maximum is the enhanced Intelligence (plus any Max Mana bonus from effects); it can't be typed in. }}
            <strong
              class='mana-max'
              data-tooltip='{{localize "CARL_RPG.Actor.Crawler.ManaMaxHint"}}'
            >{{system.mana.max}}</strong>
          </div>
        </div>

        <div class='resource flex-group-center'>
          <label class='resource-label'>
            {{localize 'CARL_RPG.Actor.Crawler.FIELDS.attributes.level.value.label'}}
          </label>
          <div class='resource-content flexrow flex-center flex-between'>
            <input
              type='text'
              name='system.attributes.level.value'
              value='{{system.attributes.level.value}}'
              data-dtype='Number'
            />
          </div>
          {{! Level Up button and banked stat points (these work even while the sheet is locked) }}
          <div class='level-actions'>
            {{#if canLevelUp}}
              <a
                class='level-up' draggable='true' data-carl-macro='levelUp'
                data-action='levelUp'
                data-tooltip='{{localize "CARL_RPG.Level.UpTooltip"}}'
              ><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Level.Up'}}</a>
            {{/if}}
            {{#if system.points.available}}
              <a
                class='spend-points {{#unless system.points.canSpend}}locked{{/unless}}'
                data-action='spendPoints'
                data-tooltip='{{#if system.points.canSpend}}{{localize "CARL_RPG.Level.SpendTooltip"}}{{else}}{{localize "CARL_RPG.Level.BankedTooltip"}}{{/if}}'
              ><i class='fas {{#if system.points.canSpend}}fa-plus{{else}}fa-lock{{/if}}'></i> {{system.points.available}} {{localize 'CARL_RPG.Level.PointsShort'}}</a>
            {{/if}}
          </div>
        </div>

        {{#if (eq actor.type 'crawler')}}
          <div class='resource flex-group-center'>
            <label for='system.aiFavor' class='resource-label'>
              {{localize 'CARL_RPG.Actor.Crawler.Combat.AIFavor'}}
            </label>
            <div class='resource-content flexrow flex-center flex-between'>
              <input
                type='text'
                name='system.aiFavor'
                value='{{system.aiFavor}}'
                data-dtype='Number'
              />
            </div>
          </div>
        {{/if}}
      {{/if}}

      {{#if (eq actor.type 'mob')}}
        {{! Mobs: Level, Actions and (for crawler mobs, in edit mode) Crawler kills }}
        <div class='resource flex-group-center'>
          <label class='resource-label'>
            {{localize 'CARL_RPG.Actor.Crawler.FIELDS.attributes.level.value.label'}}
          </label>
          <div class='resource-content flexrow flex-center flex-between'>
            <input
              type='text'
              name='system.attributes.level.value'
              value='{{system.attributes.level.value}}'
              data-dtype='Number'
            />
          </div>
        </div>

        <div class='resource flex-group-center'>
          <label for='system.actions.base' class='resource-label'>
            {{localize 'CARL_RPG.Actor.Mob.Header.Actions'}}
          </label>
          <div class='resource-content flexrow flex-center flex-between'>
            {{#if system.actions.perCrawler}}
              {{! Elites and bosses get one action per crawler in the encounter }}
              <span class='per-crawler' data-tooltip='{{localize "CARL_RPG.MobTypes.PerCrawlerHint"}}'>{{localize 'CARL_RPG.MobTypes.PerCrawler'}}</span>
            {{else}}
              <input
                type='text'
                name='system.actions.base'
                value='{{system.actions.base}}'
                data-dtype='Number'
              />
              {{#if system.bonuses.actions}}
                <span class='bonus-note' data-tooltip='{{numberFormat system.bonuses.actions decimals=0}}'>= {{system.actions.max}}</span>
              {{/if}}
            {{/if}}
          </div>
        </div>
      {{/if}}

      {{! A crawler mob's Crawler Killer count (shown as skulls by its name), edit mode only }}
      {{#if (eq actor.type 'mob')}}{{#if (eq system.mobType 'crawler')}}{{#if editMode}}
        {{! Styled like the other boxes in the row (Level, Floor, Actions): the label above the number }}
        <div class='resource flex-group-center'>
          <label for='system.crawlerKills' class='resource-label'>
            {{localize 'CARL_RPG.Kills.Label'}}
          </label>
          <div class='resource-content flexrow flex-center flex-between'>
            <input
              type='text'
              name='system.crawlerKills'
              value='{{system.crawlerKills}}'
              data-dtype='Number'
            />
          </div>
        </div>
      {{/if}}{{/if}}{{/if}}

      {{! GM only: pin this mob's own Floor (for its Evade, DR, check and attack numbers) }}
      {{#if (eq actor.type 'mob')}}{{#if isGM}}
        <div class='resource flex-group-center'>
          <label class='resource-label' data-tooltip='{{localize "CARL_RPG.Actor.Mob.Header.PinFloorHint"}}'>
            <input type='checkbox' name='system.floorPinned' {{#if system.floorPinned}}checked{{/if}} />
            {{localize 'CARL_RPG.Actor.Mob.Header.PinFloor'}}
          </label>
          <div class='resource-content flexrow flex-center flex-between'>
            <input type='text' name='system.floorPin' value='{{floorPinValue}}' data-dtype='Number' />
          </div>
        </div>
      {{/if}}{{/if}}

      {{! Size is shared by crawlers and mobs }}
      <div class='resource flex-group-center'>
        <label for='system.size' class='resource-label'>
          {{localize 'CARL_RPG.Actor.Crawler.Combat.Size'}}
        </label>
        <div class='resource-content flexrow flex-center flex-between'>
          <select name='system.size'>
            {{selectOptions sizeOptions selected=system.size}}
          </select>
        </div>
        {{#if sizeNow}}
          <small class='bonus-note'>{{localize 'CARL_RPG.Upgrades.SizeNow' size=sizeNow}}</small>
        {{/if}}
      </div>
    </div>

    {{#if (ne actor.type 'mob')}}
      {{! Defenses and movement: always visible, so they live in the header }}
      <div class='defenses'>
        <div class='defense'>
          <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Combat.DR'}}</label>
          <div class='defense-values'>
            <div class='defense-cell'>
              {{! Armor is the Damage Resistance of everything equipped, so it can't be typed in }}
              <strong>{{system.dr.armor}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Armor'}}</label>
            </div>
            <span>+</span>
            <div class='defense-cell'>
              <strong>{{numberFormat system.bonuses.dr decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Buffs'}}</label>
            </div>
            <span>=</span>
            <div class='defense-cell total'>
              <strong>{{system.dr.total}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Total'}}</label>
            </div>
          </div>
        </div>

        <div class='defense'>
          <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Combat.Evade'}}</label>
          <div class='defense-values'>
            <div class='defense-cell'>
              <strong>{{numberFormat system.abilities.dex.mod decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.DexMod'}}</label>
            </div>
            <span>+</span>
            <div class='defense-cell'>
              <strong>{{numberFormat system.bonuses.evade decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Buffs'}}</label>
            </div>
            <span>=</span>
            <div class='defense-cell total'>
              <strong>{{system.evade.total}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Total'}}</label>
            </div>
          </div>
        </div>

        <div class='defense'>
          <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Combat.Move'}}</label>
          <div class='defense-values'>
            <div class='defense-cell'>
              <input type='text' name='system.move.base' value='{{system.move.base}}' data-dtype='Number' />
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Base'}}</label>
            </div>
            <span>+</span>
            <div class='defense-cell'>
              <strong>{{numberFormat system.bonuses.move decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Buffs'}}</label>
            </div>
            <span>=</span>
            <div class='defense-cell total'>
              <strong>{{system.move.total}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Total'}}</label>
            </div>
            <div class='defense-cell'>
              <input type='text' name='system.move.step' value='{{system.move.step}}' data-dtype='Number' />
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Step'}}{{#if system.bonuses.step}} ({{system.move.stepTotal}}){{/if}}</label>
            </div>
          </div>
        </div>
      </div>
    {{/if}}

    {{#if (eq actor.type 'mob')}}
      {{! Mob combat numbers. Surprise and Evade are formulas (10 + mod + Floor + effects); the Damage Resistance total includes the Floor (the floor itself isn't shown on the sheet). }}
      <div class='defenses'>
        <div class='defense'>
          <label class='resource-label'>{{localize 'CARL_RPG.Actor.Mob.Header.Surprise'}}</label>
          <div class='defense-values'>
            <div class='defense-cell'>
              <strong>{{numberFormat system.abilities.int.mod decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Mob.Header.IntMod'}}</label>
            </div>
            <span>+</span>
            <div class='defense-cell'>
              <strong>{{numberFormat system.bonuses.surprise decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Buffs'}}</label>
            </div>
            <span>=</span>
            <div class='defense-cell total'>
              <strong>{{system.surpriseTotal}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Total'}}</label>
            </div>
          </div>
        </div>

        {{! A mob's Evade is 10 + Dex mod + Floor + effects (no typed number); the base and the Floor aren't shown. }}
        {{#if seesMobNumbers}}
        <div class='defense'>
          <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Combat.Evade'}}</label>
          <div class='defense-values'>
            <div class='defense-cell'>
              <strong>{{numberFormat system.abilities.dex.mod decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.DexMod'}}</label>
            </div>
            <span>+</span>
            <div class='defense-cell'>
              <strong>{{numberFormat system.bonuses.evade decimals=0}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Buffs'}}</label>
            </div>
            <span>=</span>
            <div class='defense-cell total'>
              <strong>{{system.evadeTotal}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Total'}}</label>
            </div>
          </div>
        </div>
        {{/if}}

        <div class='defense'>
          <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Combat.Move'}}</label>
          <div class='defense-values'>
            <div class='defense-cell'>
              <input type='text' name='system.move' value='{{system.move}}' data-dtype='Number' />
            </div>
            <span>=</span>
            <div class='defense-cell total'>
              <strong>{{system.moveTotal}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Total'}}</label>
            </div>
          </div>
        </div>

        {{#if seesMobNumbers}}
        <div class='defense'>
          <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Combat.DR'}}</label>
          <div class='defense-values'>
            <div class='defense-cell'>
              <input type='text' name='system.dr' value='{{system.dr}}' data-dtype='Number' />
            </div>
            <span>=</span>
            <div class='defense-cell total'>
              <strong>{{system.drTotal}}</strong>
              <label>{{localize 'CARL_RPG.Actor.Crawler.Combat.Total'}}</label>
            </div>
          </div>
        </div>
        {{/if}}
      </div>
    {{/if}}
  </div>
</header>
