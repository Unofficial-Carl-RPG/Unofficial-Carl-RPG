{{! Features (Skills) Tab }}
<section
  class='tab features scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='features'
>
  <section class='main'>
    <ol class='items-list'>
      <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Name'}}</div>
        <div class='item-prop'>{{#if @root.isPet}}{{localize 'CARL_RPG.Pets.Floor'}}{{else}}{{localize 'CARL_RPG.Item.Skill.FIELDS.rank.label'}}{{/if}}</div>
        {{! Whether the crawler can try to raise this skill's rank (not for pets: they use the floor) }}
        {{#unless @root.isPet}}
          <div class='item-prop item-advance' data-tooltip='{{localize "CARL_RPG.Item.Skill.FIELDS.advanceable.label"}}'>{{localize 'CARL_RPG.Item.Skill.AdvanceShort'}}</div>
        {{/unless}}
        <div class='item-controls'>
          {{#if @root.editable}}
            <a
              class='item-control item-create'
              data-tooltip='Create item'
              data-action='createDoc'
              data-document-class='Item'
              data-type='skill'
            >
              <i class='fas fa-plus'></i>
              {{localize 'DOCUMENT.New' type='feature'}}
            </a>
          {{/if}}
        </div>
      </li>
      {{#each features as |item id|}}
        <li
          class='item flexrow draggable'
          data-item-id='{{item._id}}'
          data-document-class='Item'
        >
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable' data-roll-type='item' data-action='roll'>
                <img
                  src='{{item.img}}'
                  data-tooltip='{{itemTip item}}'
                  width='24'
                  height='24'
                />
              </a>
            </div>
            <div>{{item.name}}{{#if item.usesPips.length}} <span class='uses-pips' data-tooltip='{{localize "CARL_RPG.Uses.Tooltip"}}'>{{#each item.usesPips}}<i class='fas fa-circle uses-pip {{#unless this}}spent{{/unless}}'></i>{{/each}}</span>{{/if}}</div>
          </div>
          <div class='item-prop'>{{item.system.rank}}</div>
          {{#unless @root.isPet}}
            <div class='item-prop item-advance'>
              <a
                class='item-control'
                data-action='toggleAdvanceable'
                data-tooltip='{{localize "CARL_RPG.Item.Skill.FIELDS.advanceable.label"}}'
              >
                <i class='fas {{#if item.system.advanceable}}fa-check-square{{else}}fa-square{{/if}}'></i>
              </a>
              {{#if item.system.advanceable}}
                <a
                  class='item-control advance-roll {{#if (lookup @root.advanceTried item.id)}}tried{{/if}}'
                  data-action='advanceSkill'
                  data-tooltip='{{localize "CARL_RPG.Advance.Try"}}'
                ><i class='fas fa-dice-d20'></i></a>
              {{/if}}
            </div>
          {{/unless}}
          <div class='item-controls'>
            <a
              class='item-control item-edit'
              data-tooltip='{{localize "DOCUMENT.Update" type='skill'}}'
              data-action='viewDoc'
            >
              <i class='fas fa-edit'></i>
            </a>
            {{#if @root.editable}}
              <a
                class='item-control item-delete'
                data-tooltip='{{localize "DOCUMENT.Delete" type='skill'}}'
                data-action='deleteDoc'
              >
                <i class='fas fa-trash'></i>
              </a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ol>
    {{#if @root.editMode}}{{#if @root.editable}}
      <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Drop.skill'}}</div>
    {{/if}}{{/if}}
  </section>
</section>
