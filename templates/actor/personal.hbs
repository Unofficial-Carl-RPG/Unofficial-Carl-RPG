{{! Personal tab (crawlers): sponsors, kills, and later clubs, personal space and deity }}
<section
  class='tab personal scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='personal'
>
  <div class='sponsors-panel flexcol'>
    <label class='resource-label'>{{localize 'CARL_RPG.Sponsors.Title'}}</label>
    {{#each sponsors as |sponsor|}}
      <div class='sponsor-row'>
        <img src='{{sponsor.img}}' width='24' height='24' />
        <span>{{sponsor.name}}</span>
        {{#if ../isGM}}
          <button type='button' data-action='sendGift' data-sponsor='{{sponsor.id}}' data-tooltip='{{localize "CARL_RPG.Sponsors.GiftHint"}}'>
            {{localize 'CARL_RPG.Sponsors.SendGift'}}
          </button>
        {{/if}}
      </div>
    {{else}}
      <p class='hint'>{{localize 'CARL_RPG.Sponsors.Empty'}}</p>
    {{/each}}
    {{#if editable}}
      <div class='drop-box'>{{localize 'CARL_RPG.Sponsors.Add'}}</div>
    {{/if}}
  </div>

  <div class='deity-panel flexcol'>
    <label class='resource-label'>{{localize 'TYPES.Item.deity'}}</label>
    {{#if deity}}
      <p><strong>{{deity.name}}</strong></p>
      <div class='deity-description'>{{{deity.description}}}</div>
    {{else}}
      <p class='hint'>{{localize 'CARL_RPG.Sponsors.NoDeity'}}</p>
    {{/if}}
    {{#if editable}}
      <div class='drop-box'>{{localize 'CARL_RPG.Sponsors.AddDeity'}}</div>
    {{/if}}
  </div>

  <div class='mounts-panel flexcol'>
    <label class='resource-label'>{{localize 'TYPES.Actor.mount'}}</label>
    {{#each mounts as |mount|}}
      <div class='mount-row'>
        <img src='{{mount.img}}' width='24' height='24' />
        <span>{{mount.name}}</span>
        <span class='hint'>{{localize 'CARL_RPG.Actor.Mount.Health'}} {{mount.health}}</span>
      </div>
    {{else}}
      <p class='hint'>{{localize 'CARL_RPG.Sponsors.NoMounts'}}</p>
    {{/each}}
  </div>

  <div class='clubs-panel flexcol'>
    <label class='resource-label'>{{localize 'TYPES.Item.club'}}</label>
    {{#each clubs as |club|}}
      <div class='club-row'>
        <img src='{{club.img}}' width='24' height='24' />
        <span>{{club.name}}</span>
        {{#if club.role}}<span class='hint'>{{club.role}}</span>{{/if}}
      </div>
    {{else}}
      <p class='hint'>{{localize 'CARL_RPG.Sponsors.NoClubs'}}</p>
    {{/each}}
    {{#if editable}}
      <div class='drop-box'>{{localize 'CARL_RPG.Sponsors.AddClub'}}</div>
    {{/if}}
  </div>

  <div class='space-panel flexcol'>
    <label class='resource-label'>{{localize 'TYPES.Item.personalSpace'}}</label>
    {{#if personalSpace}}
      <p><strong>{{personalSpace.name}}</strong> · {{localize 'CARL_RPG.Item.PersonalSpace.FIELDS.tier.label'}} {{personalSpace.tier}} · {{personalSpace.size}}</p>
      <ul>
        {{#each personalSpace.amenities as |amenity|}}
          <li><strong>{{amenity.name}}</strong> {{amenity.description}}</li>
        {{/each}}
      </ul>
    {{else}}
      <p class='hint'>{{localize 'CARL_RPG.Sponsors.NoSpace'}}</p>
    {{/if}}
  </div>

  <div class='kills-panel flexcol'>
    <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Extras.Kills'}}</label>
    {{#each system.killLog as |kill index|}}
      <div class='kill-row'>
        {{#if ../editable}}
          <input type='text' name='system.killLog.{{index}}.name' value='{{kill.name}}' placeholder='{{localize "CARL_RPG.Kills.NamePlaceholder"}}' />
          <input type='text' name='system.killLog.{{index}}.note' value='{{kill.note}}' placeholder='{{localize "CARL_RPG.Kills.NotePlaceholder"}}' />
          <button type='button' data-action='removeKill' data-index='{{index}}' data-tooltip='{{localize "CARL_RPG.Kills.Remove"}}'>
            <i class='fas fa-trash'></i>
          </button>
        {{else}}
          <strong>{{kill.name}}</strong>
          <span>{{kill.note}}</span>
        {{/if}}
      </div>
    {{else}}
      <p class='hint'>{{localize 'CARL_RPG.Kills.Empty'}}</p>
    {{/each}}
    {{#if editable}}
      <button type='button' data-action='addKill'>{{localize 'CARL_RPG.Kills.Add'}}</button>
    {{/if}}
  </div>
</section>
