{{! Personal tab (crawlers): kills, and later sponsors, clubs, personal space and deity }}
<section
  class='tab personal scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='personal'
>
  <div class='kills-panel flexcol'>
    <label class='resource-label'>{{localize 'CARL_RPG.Actor.Crawler.Extras.Kills'}}</label>
    {{#each system.killLog as |kill index|}}
      <div class='kill-row'>
        {{#if ../editable}}
          <input type='text' name='system.killLog.{{index}}.name' value='{{kill.name}}' placeholder='{{localize "CARL_RPG.Kills.NamePlaceholder"}}' />
          <input type='text' name='system.killLog.{{index}}.note' value='{{kill.note}}' placeholder='{{localize "CARL_RPG.Kills.NotePlaceholder"}}' />
          <button type='button' data-action='removeKill' data-index='{{index}}' data-tooltip='{{localize "CARL_RPG.Kills.Remove"}}'>
            <i class='fas fa-trash'></i>
          </button>
        {{else}}
          <strong>{{kill.name}}</strong>
          <span>{{kill.note}}</span>
        {{/if}}
      </div>
    {{else}}
      <p class='hint'>{{localize 'CARL_RPG.Kills.Empty'}}</p>
    {{/each}}
    {{#if editable}}
      <button type='button' data-action='addKill'>{{localize 'CARL_RPG.Kills.Add'}}</button>
    {{/if}}
  </div>
</section>
