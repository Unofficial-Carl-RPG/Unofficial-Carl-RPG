{{! Buffs/Debuffs Tab: buffs (3 active at most), debuffs and passives }}
<section
  class='tab effects scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='effects'
>
  {{#each effectGroups as |group|}}
    <ol class='effects-list'>
      <li class='effect flexrow effects-header'>
        <div class='effect-name'>
          {{localize group.label}}
          {{#if group.isBuff}}({{group.activeCount}}/{{group.limit}}){{/if}}
        </div>
        <div class='effect-controls'>
          {{#if @root.editable}}
            <a
              class='effect-control item-create'
              data-action='createEffect'
              data-kind='{{group.kind}}'
            >
              <i class='fas fa-plus'></i>
              {{localize 'CARL_RPG.Effect.NewButton'}}
            </a>
          {{/if}}
        </div>
      </li>
      {{#each group.effects as |effect|}}
        <li
          class='effect flexrow draggable {{#unless effect.active}}inactive{{/unless}}'
          data-effect-id='{{effect.id}}'
          data-parent-id='{{@root.actor.id}}'
          data-document-class='ActiveEffect'
        >
          <div class='effect-name'>
            <div class='effect-image'>
              <img
                src='{{effect.img}}'
                data-tooltip='{{effect.name}}'
                width='24'
                height='24'
              />
            </div>
            <div>
              {{effect.name}}
              {{#if effect.stackable}}
                <span class='effect-stacks'>
                  &times;{{effect.stacks}}{{#if effect.maxStacks}}/{{effect.maxStacks}}{{/if}}
                </span>
              {{/if}}
              {{#if effect.stacksSlot}}
                <i class='fas fa-link' data-tooltip='{{localize "CARL_RPG.Effect.StackedTip"}}'></i>
              {{/if}}
              {{#if effect.equipControlled}}
                <i class='fas fa-shield-halved' data-tooltip='{{localize "CARL_RPG.Effect.EquipControlledTip"}}'></i>
              {{/if}}
              {{#if effect.roundsLeft}}
                <span class='effect-rounds' data-tooltip='{{localize "CARL_RPG.Effect.RoundsLeft" count=effect.roundsLeft}}'><i class='fas fa-hourglass-half'></i> {{effect.roundsLeft}}</span>
              {{/if}}
              {{#if effect.lockedUntil}}
                <i class='fas fa-lock' data-tooltip='{{localize "CARL_RPG.Upgrades.EffectLocked" name=effect.name rank=effect.lockedUntil}}'></i>
              {{/if}}
              {{#if effect.permanent}}
                <i class='fas fa-thumbtack' data-tooltip='{{localize "CARL_RPG.Effect.Permanent"}}'></i>
              {{/if}}
              {{#if effect.sources}}
                <small class='effect-source'>{{effect.sources}}</small>
              {{/if}}
            </div>
          </div>
          <div class='effect-controls'>
            {{#if effect.stackable}}
              <a
                class='effect-control'
                data-action='effectStacks'
                data-mode='remove'
                data-tooltip='{{localize "CARL_RPG.Effect.RemoveStack"}}'
              ><i class='fas fa-minus'></i></a>
              <a
                class='effect-control'
                data-action='effectStacks'
                data-mode='add'
                data-tooltip='{{localize "CARL_RPG.Effect.AddStack"}}'
              ><i class='fas fa-plus'></i></a>
              <a
                class='effect-control'
                data-action='effectStacks'
                data-mode='all'
                data-tooltip='{{localize "CARL_RPG.Effect.RemoveAllStacks"}}'
              ><i class='fas fa-eraser'></i></a>
            {{/if}}
            <a
              class='effect-control'
              data-action='toggleEffect'
              data-tooltip='{{#if effect.active}}{{localize "CARL_RPG.Effect.TurnOff"}}{{else}}{{localize "CARL_RPG.Effect.TurnOn"}}{{/if}}'
            >
              <i class='fas {{#if effect.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}'></i>
            </a>
            <a
              class='effect-control effect-edit'
              data-action='viewDoc'
              data-tooltip='{{localize "DOCUMENT.Update" type="Effect"}}'
            ><i class='fas fa-edit'></i></a>
            {{#if @root.editable}}
              <a
                class='effect-control effect-delete'
                data-action='deleteDoc'
                data-tooltip='{{localize "DOCUMENT.Delete" type="Effect"}}'
              ><i class='fas fa-trash'></i></a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ol>
  {{/each}}
  {{#if @root.editMode}}{{#if @root.editable}}
    <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Drop.effect'}}</div>
  {{/if}}{{/if}}
</section>
