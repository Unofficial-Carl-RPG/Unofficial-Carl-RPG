{{! Gear Tab }}
<section class='tab gear scrollable {{tab.cssClass}}' data-group='primary' data-tab='gear'>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'Name'}}</div>
      <div class='item-prop item-equipped'>{{localize 'CARL_RPG.Item.Gear.FIELDS.equipped.label'}}</div>
      <div class='item-prop'>{{localize 'CARL_RPG.Item.Gear.FIELDS.slot.label'}}</div>
      <div class='item-prop item-dr'>{{localize 'CARL_RPG.Item.Gear.DRShort'}}</div>
      <div class='item-prop item-skill'>{{localize 'TYPES.Item.skill'}}</div>
      <div class='item-controls'>
        {{#if @root.editable}}
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type='Item'}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='gear'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='item'}}
          </a>
        {{/if}}
      </div>
    </li>
    {{#each gear as |item id|}}
      <li
        class='item flexrow draggable {{#if item.system.equipped}}equipped{{/if}}'
        data-item-id='{{item._id}}'
        data-document-class='Item'
      >
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action='roll'>
              <img
                src='{{item.img}}'
                data-item-tip='{{item.uuid}}'
                width='24'
                height='24'
              />
            </a>
          </div>
          <div>{{item.name}}{{#if item.usesPips.length}} <span class='uses-pips' data-tooltip='{{localize "CARL_RPG.Uses.Tooltip"}}'>{{#each item.usesPips}}<i class='fas fa-circle uses-pip {{#unless this}}spent{{/unless}}'></i>{{/each}}</span>{{/if}}</div>
        </div>
        <div class='item-prop item-equipped'>
          <a
            class='item-control'
            data-action='toggleEquipped'
            data-tooltip='{{#if item.system.equipped}}{{localize "CARL_RPG.Item.Gear.Equip.Unequip"}}{{else}}{{localize "CARL_RPG.Item.Gear.Equip.Equip"}}{{/if}}'
          >
            <i class='fas {{#if item.system.equipped}}fa-check-square{{else}}fa-square{{/if}}'></i>
          </a>
        </div>
        <div class='item-prop'>{{localize (lookup @root.config.gearSlots item.system.slot)}}</div>
        <div class='item-prop item-dr'>{{item.system.dr}}</div>
        <div class='item-prop item-skill'>
          {{#with (lookup @root.rollChoices item._id) as |choices|}}{{#if choices}}
            <select class='roll-skill' data-item-id='{{item._id}}' data-tooltip='{{localize "CARL_RPG.Weapon.RollsWithHint"}}'{{#unless @root.editable}} disabled{{/unless}}>
              {{#each choices as |c|}}<option value='{{c.uuid}}'{{#if c.selected}} selected{{/if}}>{{c.name}}</option>{{/each}}
            </select>
          {{/if}}{{/with}}
        </div>
        <div class='item-controls'>
          <a
            class='item-control item-edit'
            data-tooltip='{{localize "DOCUMENT.Update" type='Gear'}}'
            data-action='viewDoc'
          >
            <i class='fas fa-edit'></i>
          </a>
          {{#if @root.editable}}
            <a
              class='item-control item-delete'
              data-tooltip='{{localize "DOCUMENT.Delete" type='Gear'}}'
              data-action='deleteDoc'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{#if @root.editMode}}{{#if @root.editable}}
    <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Drop.gear'}}</div>
  {{/if}}{{/if}}
</section>