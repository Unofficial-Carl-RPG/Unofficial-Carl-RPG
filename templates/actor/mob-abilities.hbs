{{! Mob Abilities Tab }}
<section class='tab mobAbilities scrollable {{tab.cssClass}}' data-group='primary' data-tab='mobAbilities'>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'Name'}}</div>
      <div class='item-prop'>{{localize 'CARL_RPG.Item.MobAbility.FIELDS.rank.label'}}</div>
      <div class='item-controls'>
        {{#if @root.editable}}
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type="Mob Ability"}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='mobAbility'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='mob ability'}}
          </a>
        {{/if}}
      </div>
    </li>
    {{#each mobAbilities as |item id|}}
      <li
        class='item flexrow draggable'
        data-item-id='{{item._id}}'
        data-document-class='Item'
      >
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action='roll'>
              <img
                src='{{item.img}}'
                data-tooltip='{{itemTip item}}'
                width='24'
                height='24'
              />
            </a>
          </div>
          <div>{{item.name}}{{#if item.usesPips.length}} <span class='uses-pips' data-tooltip='{{localize "CARL_RPG.Uses.Tooltip"}}'>{{#each item.usesPips}}<i class='fas fa-circle uses-pip {{#unless this}}spent{{/unless}}'></i>{{/each}}</span>{{/if}}</div>
        </div>
        <div class='item-prop'>{{item.system.rank}}</div>
        <div class='item-controls'>
          <a
            class='item-control item-edit'
            data-tooltip='{{localize "DOCUMENT.Update" type="Mob Ability"}}'
            data-action='viewDoc'
          >
            <i class='fas fa-edit'></i>
          </a>
          {{#if @root.editable}}
            <a
              class='item-control item-delete'
              data-tooltip='{{localize "DOCUMENT.Delete" type="Mob Ability"}}'
              data-action='deleteDoc'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{#if @root.editMode}}{{#if @root.editable}}
    <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Drop.mobAbility'}}</div>
  {{/if}}{{/if}}
</section>
