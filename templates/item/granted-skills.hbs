{{! Skills Tab (Race / Class): skills granted at a set rank }}
<section
  class='tab grantedSkills scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='grantedSkills'
>
  <p class='skills-hint'>{{localize 'CARL_RPG.Origin.SkillsHint'}}</p>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'CARL_RPG.Origin.GrantedSkills'}}</div>
      <div class='item-prop'>{{localize 'CARL_RPG.Item.Skill.FIELDS.rank.label'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each grantedRows as |g|}}
      {{#if g.isPick}}
      {{! The player picks: a filter instead of one skill }}
      <li class='item flexrow pick-grant-row'>
        <div class='item-name pick-filter'>
          <span class='pick-label'>{{localize 'CARL_RPG.Picks.PlayerPicks'}}</span>
          <input type='number' class='event-value pick-count' data-path='grantedSkills.{{g.index}}.count' value='{{g.count}}' min='1' step='1' data-tooltip='{{localize "CARL_RPG.Picks.CountHint"}}' />
          <input type='text' class='event-value' list='carl-skill-tags' data-path='grantedSkills.{{g.index}}.tag' value='{{g.tag}}' placeholder='{{localize "CARL_RPG.Tags.Placeholder"}}' />
          <select class='event-value' data-path='grantedSkills.{{g.index}}.stat'>
            {{selectOptions @root.pickStatOptions selected=g.stat localize=true}}
          </select>
          <select class='event-value' data-path='grantedSkills.{{g.index}}.kind'>
            {{selectOptions @root.pickKindOptions selected=g.kind localize=true}}
          </select>
        </div>
        <div class='item-prop'>
          <input type='number' class='event-value' data-path='grantedSkills.{{g.index}}.rank' value='{{g.rank}}' min='0' step='1' />
        </div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a class='item-control item-delete' data-action='removeGrantedSkill' data-gi='{{g.index}}' data-tooltip='{{localize "CARL_RPG.Events.Remove"}}'>
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
      {{else}}
      <li class='item flexrow {{#if g.missing}}missing{{/if}}'>
        <div class='item-name'>
          <div class='item-image'>
            <img src='{{g.img}}' data-item-tip='{{g.uuid}}' width='24' height='24' />
          </div>
          <div>
            {{g.name}}
            {{#if g.missing}}<em>({{localize 'CARL_RPG.Events.Missing'}})</em>{{/if}}
          </div>
        </div>
        <div class='item-prop'>
          <input
            type='number'
            class='event-value'
            data-path='grantedSkills.{{g.index}}.rank'
            value='{{g.rank}}'
            min='0'
            step='1'
          />
        </div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a class='item-control item-delete' data-action='removeGrantedSkill' data-gi='{{g.index}}' data-tooltip='{{localize "CARL_RPG.Events.Remove"}}'>
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
      {{/if}}
    {{/each}}
  </ol>
  {{#if skillTagNames.length}}
    <datalist id='carl-skill-tags'>
      {{#each skillTagNames as |name|}}<option value='{{name}}'></option>{{/each}}
    </datalist>
  {{/if}}
  {{#if editable}}
    {{#if canPickSkills}}<a class='event-add' data-action='addGrantedPick'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Picks.AddGrant'}}</a>{{/if}}
    <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Origin.Drop.skillGrant'}}</div>
  {{/if}}
</section>
