{{! Description Tab }}
<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='description'
>
  {{#if itemBadges.length}}
    <div class='item-badges'>
      {{#each itemBadges as |badge|}}<span class='item-badge'>{{badge}}</span>{{/each}}
    </div>
  {{/if}}
  {{#if (eq item.type 'gear')}}{{#if embeddedSkills.length}}
    <div class='item-badges'>
      {{#each embeddedSkills as |s|}}{{#if s.rollsWith}}<span class='item-badge'>{{localize 'CARL_RPG.Badges.RollsWith'}} {{s.name}}{{#if s.stat}} ({{s.stat}}){{/if}}</span>{{/if}}{{/each}}
      {{#each embeddedSkills as |s|}}{{#unless s.rollsWith}}<span class='item-badge'>{{localize 'CARL_RPG.Badges.AlsoGrants'}} {{s.name}}</span>{{/unless}}{{/each}}
    </div>
  {{/if}}{{/if}}
  {{! Both descriptions are collapsible; each person's choice is remembered on their own computer. }}
  <details class='desc-block' data-desc-key='description' open>
    <summary>{{localize 'CARL_RPG.Item.base.FIELDS.description.label'}}</summary>
    {{! Editors must receive enriched text data from getData to properly handle rolls, UUID links, etc. }}
    {{#if editable}}
      <prose-mirror name="system.description" data-document-uuid="{{item.uuid}}" value="{{system.description}}" collaborate="true" toggled="true">
        {{{enrichedDescription}}}
      </prose-mirror>
    {{else}} {{{enrichedDescription}}}
    {{/if}}
  </details>

  <details class='desc-block' data-desc-key='shortDescription' open>
    <summary>{{localize 'CARL_RPG.Item.base.FIELDS.shortDescription.label'}}</summary>
    {{#if editable}}
      <prose-mirror name="system.shortDescription" data-document-uuid="{{item.uuid}}" value="{{system.shortDescription}}" collaborate="true" toggled="true">
        {{{enrichedShortDescription}}}
      </prose-mirror>
    {{else}} {{{enrichedShortDescription}}}
    {{/if}}
  </details>

  {{! Skills and spells: every upgrade, with the ones not reached yet dimmed }}
  {{#if upgradeList.length}}
    <div class='upgrade-list'>
      <h3>{{localize 'CARL_RPG.Upgrades.Title'}}</h3>
      <ul>
        {{#each upgradeList as |up|}}
          <li class='{{#unless up.unlocked}}locked{{/unless}}'>
            <i class='fas {{#if up.unlocked}}fa-unlock{{else}}fa-lock{{/if}}'></i>
            <strong>{{localize 'CARL_RPG.Upgrades.Rank'}} {{up.rank}}:</strong> {{up.text}}
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}
</section>
