{{! Guaranteed Tab (Loot Box): drop items here; they are always granted, outside the random draws }}
<section
  class='tab guaranteed scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='guaranteed'
>
  {{#each guaranteedWarnings as |warning|}}
    <p class='loot-warning'><i class='fas fa-triangle-exclamation'></i> {{localize warning}}</p>
  {{/each}}

  <p class='skills-hint'>{{localize 'CARL_RPG.Loot.GuaranteedHint'}}</p>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'CARL_RPG.Loot.Guaranteed'}}</div>
      <div class='item-prop guaranteed-formula-col'>{{localize 'CARL_RPG.Loot.Amount'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each guaranteedRows as |entry|}}
      <li
        class='item flexrow guaranteed-row {{#if entry.missing}}missing{{/if}}{{#if entry.invalid}}missing{{/if}}'
        data-index='{{entry.index}}'
        data-list='guaranteed'
      >
        <div class='item-name'>
          <div class='item-image'>
            <img src='{{entry.img}}' data-item-tip='{{entry.uuid}}' width='24' height='24' />
          </div>
          <div>
            {{entry.name}}
            {{#if entry.missing}}<em>({{localize 'CARL_RPG.Loot.Missing'}})</em>{{/if}}
            {{#if entry.invalid}}<em>({{localize 'CARL_RPG.Loot.NotAllowed'}})</em>{{/if}}
          </div>
        </div>
        <div class='item-prop guaranteed-formula-col'>
          <input
            class='guaranteed-formula {{#if entry.badFormula}}bad-formula{{/if}}'
            type='text'
            value='{{entry.quantity}}'
            placeholder='1'
            data-tooltip='{{localize "CARL_RPG.Loot.AmountHint"}}'
          />
        </div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a
              class='item-control item-delete'
              data-action='removeReward'
              data-tooltip='{{localize "CARL_RPG.Loot.RemoveGuaranteed"}}'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{#if editable}}
    <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Drop.guaranteed'}}</div>
  {{/if}}
</section>
