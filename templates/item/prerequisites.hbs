{{! Prerequisites Tab (Race / Class): all of these must be met to take it }}
<section
  class='tab prerequisites scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='prerequisites'
>
  <p class='skills-hint'>{{localize 'CARL_RPG.Origin.PrereqHint'}}</p>
  <datalist id='carl-tags-prereq'>
    {{#each classTagNames as |name|}}<option value='{{name}}'></option>{{/each}}
  </datalist>
  <datalist id='carl-tags-prereq-skill'>
    {{#each prereqSkillTagNames as |name|}}<option value='{{name}}'></option>{{/each}}
  </datalist>
  {{#each prereqRows as |p|}}
    <div class='event-row'>
      <select data-path='{{p.path}}.type'>
        {{selectOptions @root.prereqOptions.types selected=p.type localize=true}}
      </select>
      {{#if p.showStat}}
        <select data-path='{{p.path}}.stat'>
          {{selectOptions @root.prereqOptions.stats selected=p.stat localize=true}}
        </select>
      {{/if}}
      {{#if p.showStats}}
        <span class='prereq-stats'>
          {{#each p.statBoxes as |b|}}
            <label class='prereq-stat'>
              <input type='checkbox' class='prereq-stat-toggle' data-pi='{{p.index}}' data-stat='{{b.key}}' {{checked b.checked}} {{#unless @root.editable}}disabled{{/unless}} />
              {{localize b.label}}
            </label>
          {{/each}}
        </span>
      {{/if}}
      {{#if p.showCategory}}
        <select data-path='{{p.path}}.category'>
          {{selectOptions @root.prereqOptions.categories selected=p.category localize=true}}
        </select>
      {{/if}}
      {{#if p.showTag}}
        <input type='text' class='event-amount tag-field' list='{{p.tagList}}' data-path='{{p.path}}.tag' value='{{p.tag}}' placeholder='{{localize "CARL_RPG.Tags.Placeholder"}}' />
      {{/if}}
      {{#if p.showValue}}
        <input type='number' class='event-value' data-path='{{p.path}}.value' value='{{p.value}}' step='1' />
      {{/if}}
      {{#if p.showDrop}}
        <div
          class='drop-target {{#if p.docMissing}}missing{{/if}}'
          data-accept='item'
          data-item-type='{{p.dropType}}'
          data-path='{{p.path}}'
          data-field='uuid'
        >
          {{#if p.uuid}}
            <span class='drop-name'>
              {{#if p.docName}}{{p.docName}}{{else}}{{localize 'CARL_RPG.Events.Missing'}}{{/if}}
            </span>
            {{#if @root.editable}}
              <a class='item-control' data-action='clearTarget' data-path='{{p.path}}' data-field='uuid'><i class='fas fa-xmark'></i></a>
            {{/if}}
          {{else}}
            <span class='drop-hint'>{{localize p.dropHint}}</span>
          {{/if}}
        </div>
      {{/if}}
      {{#if @root.editable}}
        <a class='item-control' data-action='removePrerequisite' data-pi='{{p.index}}' data-tooltip='{{localize "CARL_RPG.Events.Remove"}}'><i class='fas fa-trash'></i></a>
      {{/if}}
    </div>
  {{/each}}
  {{#if editable}}
    <a class='event-add' data-action='addPrerequisite'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Origin.AddPrereq'}}</a>
  {{/if}}
</section>
