{{! Random Rewards Tab (Loot Box): drop items here to add them to the random reward list }}
<section
  class='tab rewards scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='rewards'
>
  {{#each rewardWarnings as |warning|}}
    <p class='loot-warning'><i class='fas fa-triangle-exclamation'></i> {{localize warning}}</p>
  {{/each}}

  <p class='skills-hint'>{{localize 'CARL_RPG.Loot.RewardsHint'}}</p>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'CARL_RPG.Loot.RandomRewards'}}</div>
      <div class='item-prop'>{{localize 'CARL_RPG.Loot.Weight'}}</div>
      <div class='item-prop'>{{localize 'CARL_RPG.Loot.Quantity'}}</div>
      {{#if isGM}}
        <div class='item-prop'>{{localize 'CARL_RPG.Loot.Chance'}}</div>
      {{/if}}
      <div class='item-controls'></div>
    </li>
    {{#each rewardRows as |reward|}}
      <li class='item flexrow reward-row {{#if reward.missing}}missing{{/if}}{{#if reward.invalid}}missing{{/if}}' data-index='{{reward.index}}'>
        <div class='item-name'>
          <div class='item-image'>
            <img src='{{reward.img}}' data-item-tip='{{reward.uuid}}' width='24' height='24' />
          </div>
          <div>
            {{reward.name}}
            {{#if reward.missing}}<em>({{localize 'CARL_RPG.Loot.Missing'}})</em>{{/if}}
            {{#if reward.invalid}}<em>({{localize 'CARL_RPG.Loot.NotAllowed'}})</em>{{/if}}
          </div>
        </div>
        <div class='item-prop'>
          <input class='reward-weight' type='number' value='{{reward.weight}}' min='0' step='any' />
        </div>
        <div class='item-prop'>
          <input class='reward-quantity' type='number' value='{{reward.quantity}}' min='1' step='1' />
        </div>
        {{#if @root.isGM}}
          <div class='item-prop reward-chance'>{{reward.odds}}%</div>
        {{/if}}
        <div class='item-controls'>
          {{#if @root.editable}}
            <a
              class='item-control item-delete'
              data-action='removeReward'
              data-tooltip='{{localize "CARL_RPG.Loot.RemoveReward"}}'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
  {{#if editable}}
    <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Drop.rewards'}}</div>
  {{/if}}
</section>
