{{! Targeting: who an item affects when it is used, and how far (see the target prompt) }}
<div class='targeting-group'>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.mode'>{{localize 'CARL_RPG.Targeting.Mode'}}</label>
    <select name='system.targeting.mode'>
      <option value='none' {{#if (eq system.targeting.mode 'none')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ModeNone'}}</option>
      <option value='count' {{#if (eq system.targeting.mode 'count')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ModeCount'}}</option>
      <option value='self' {{#if (eq system.targeting.mode 'self')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ModeSelf'}}</option>
      <option value='area' {{#if (eq system.targeting.mode 'area')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ModeArea'}}</option>
    </select>
    <p class='hint'>{{localize 'CARL_RPG.Targeting.Hint'}}</p>
  </div>
  {{#if (eq system.targeting.mode 'count')}}
  <div class='resource'>
    <label class='resource-label' for='system.targeting.count'>{{localize 'CARL_RPG.Targeting.Count'}}</label>
    <input type='text' class='{{#if badTargeting.count}}bad-formula{{/if}}' name='system.targeting.count' value='{{system.targeting.count}}' />
    <p class='hint'>{{localize 'CARL_RPG.Targeting.FormulaHint'}}</p>
    {{#if effective.extraShapes}}
    <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowShapes' value=effective.extraShapes}}</p>
    {{/if}}
  </div>
  {{/if}}
  {{#unless (eq system.targeting.mode 'self')}}{{#unless (eq system.targeting.mode 'none')}}
  <div class='resource'>
    <label class='resource-label' for='system.targeting.range'>{{localize 'CARL_RPG.Targeting.Range'}}</label>
    <input type='text' class='{{#if badTargeting.range}}bad-formula{{/if}}' name='system.targeting.range' value='{{system.targeting.range}}' placeholder='30' />
    <p class='hint'>{{localize 'CARL_RPG.Targeting.RangeHint'}}{{#if rangePreview}} {{rangePreview}}{{/if}}</p>
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.filter'>{{localize 'CARL_RPG.Targeting.Filter'}}</label>
    <select name='system.targeting.filter'>
      <option value='any' {{#if (eq system.targeting.filter 'any')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.FilterAny'}}</option>
      <option value='enemies' {{#if (eq system.targeting.filter 'enemies')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.FilterEnemies'}}</option>
      <option value='allies' {{#if (eq system.targeting.filter 'allies')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.FilterAllies'}}</option>
    </select>
  </div>
  {{/unless}}{{/unless}}
  {{#if (eq system.targeting.mode 'area')}}
  <div class='resource'>
    <label class='resource-label' for='system.targeting.shape'>{{localize 'CARL_RPG.Targeting.Shape'}}</label>
    <select name='system.targeting.shape'>
      <option value='circle' {{#if (eq system.targeting.shape 'circle')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ShapeCircle'}}</option>
      <option value='cone' {{#if (eq system.targeting.shape 'cone')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ShapeCone'}}</option>
      <option value='ray' {{#if (eq system.targeting.shape 'ray')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ShapeRay'}}</option>
      <option value='rect' {{#if (eq system.targeting.shape 'rect')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.ShapeRect'}}</option>
    </select>
    {{#if effective.shapeChanged}}
    <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowShape' value=effective.shape}}</p>
    {{/if}}
    {{#if effective.extraShapes}}
    <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowShapes' value=effective.extraShapes}}</p>
    {{/if}}
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.size'>{{localize 'CARL_RPG.Targeting.Size'}}</label>
    <input type='text' class='{{#if badTargeting.size}}bad-formula{{/if}}' name='system.targeting.size' value='{{system.targeting.size}}' />
    {{#if effective.sizeChanged}}
    <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowSize' value=effective.sizeNow}}</p>
    {{/if}}
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.lasting'>{{localize 'CARL_RPG.Targeting.Lasting'}}</label>
    <input type='checkbox' name='system.targeting.lasting' {{checked system.targeting.lasting}} />
    <p class='hint'>{{localize 'CARL_RPG.Targeting.LastingHint'}}</p>
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.lasts'>{{localize 'CARL_RPG.Targeting.Lasts'}}</label>
    <input type='text' class='{{#if badTargeting.lasts}}bad-formula{{/if}}' name='system.targeting.lasts' value='{{system.targeting.lasts}}' />
    <p class='hint'>{{localize 'CARL_RPG.Targeting.LastsHint'}}</p>
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.kind'>{{localize 'CARL_RPG.Targeting.Kind'}}</label>
    <select name='system.targeting.kind'>
      <option value='' {{#if (eq system.targeting.kind '')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.KindNone'}}</option>
      <option value='fire' {{#if (eq system.targeting.kind 'fire')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.KindFire'}}</option>
      <option value='difficult' {{#if (eq system.targeting.kind 'difficult')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.KindDifficult'}}</option>
      <option value='poison' {{#if (eq system.targeting.kind 'poison')}}selected{{/if}}>{{localize 'CARL_RPG.Targeting.KindPoison'}}</option>
    </select>
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.areas'>{{localize 'CARL_RPG.Targeting.Areas'}}</label>
    <input type='text' class='{{#if badTargeting.areas}}bad-formula{{/if}}' name='system.targeting.areas' value='{{system.targeting.areas}}' />
    <p class='hint'>{{localize 'CARL_RPG.Targeting.FormulaHint'}}</p>
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.limit'>{{localize 'CARL_RPG.Targeting.Limit'}}</label>
    <input type='text' class='{{#if badTargeting.limit}}bad-formula{{/if}}' name='system.targeting.limit' value='{{system.targeting.limit}}' />
  </div>
  {{/if}}
  {{! Splash: beyond an area, or around each chosen target }}
  {{#unless (eq system.targeting.mode 'self')}}{{#unless (eq system.targeting.mode 'none')}}
  <div class='resource'>
    <label class='resource-label' for='system.targeting.splash'>{{localize 'CARL_RPG.Targeting.Splash'}}</label>
    <input type='text' class='{{#if badTargeting.splash}}bad-formula{{/if}}' name='system.targeting.splash' value='{{system.targeting.splash}}' />
    <p class='hint'>{{localize 'CARL_RPG.Targeting.SplashHint'}}</p>
    {{#if effective.splashChanged}}
    <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowSplash' value=effective.splashNow}}</p>
    {{/if}}
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.splashDamage'>{{localize 'CARL_RPG.Targeting.SplashDamage'}}</label>
    <input type='text' name='system.targeting.splashDamage' value='{{system.targeting.splashDamage}}' placeholder='1d6' />
    <p class='hint'>{{localize 'CARL_RPG.Targeting.SplashDamageHint'}}</p>
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.targeting.splashEffects'>{{localize 'CARL_RPG.Targeting.SplashEffects'}}</label>
    <input type='checkbox' name='system.targeting.splashEffects' {{checked system.targeting.splashEffects}} />
  </div>
  {{/unless}}{{/unless}}
</div>
