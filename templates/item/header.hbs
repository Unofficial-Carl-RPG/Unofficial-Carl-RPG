<header class='sheet-header'>
  <img
    class='profile-img'
    src='{{item.img}}'
    data-edit='img'
    data-action='onEditImage'
    data-tooltip='{{item.name}}'
  />
  <div class='header-fields'>
    <div class='document-name'>
      {{#if isOrigin}}{{#if system.earthBased}}
        {{! The earth icon sits before the name }}
        <i class='fas fa-earth-americas race-earth' data-tooltip='{{localize "CARL_RPG.Origin.EarthBased"}}'></i>
      {{/if}}{{/if}}
      {{#if (eq item.type 'lootBox')}}
        {{! The tier sits to the left of the name }}
        <select
          class='tier-select'
          name='system.tier'
          data-tooltip='{{localize "CARL_RPG.Item.LootBox.FIELDS.tier.label"}}'
        >
          {{selectOptions tiers selected=system.tier localize=true}}
        </select>
      {{/if}}
      <input name='name' type='text' value='{{item.name}}' placeholder='Name' />
    </div>
    {{! A class lists its selected tags under its name }}
    {{#if classTagLine}}
      <div class='class-tag-line'><em>{{classTagLine}}</em></div>
    {{/if}}
    {{! Quantity is always shown here, for every item that has one }}
    {{#if headerQuantity}}
      <div class='grid grid-2col'>
        <div class='resource'>
          <label class='resource-label'>{{localize 'CARL_RPG.Item.Gear.FIELDS.quantity.label'}}</label>
          <input
            type='text'
            name='system.quantity'
            value='{{system.quantity}}'
            data-dtype='Number'
          />
        </div>
      </div>
    {{/if}}
    {{#if showValue}}
      <div class='grid grid-2col'>
        <div class='resource'>
          <label class='resource-label'>{{localize 'CARL_RPG.Item.Item.FIELDS.value.label'}}</label>
          <input type='text' name='system.value' value='{{system.value}}' data-dtype='Number' {{#unless isGM}}readonly{{/unless}} />
        </div>
      </div>
    {{/if}}
  </div>
    {{#if (eq item.type 'store')}}{{#if isGM}}
    <div class='item-chat-btn'>
      <button type='button' data-action='openStore'>
        <i class='fas fa-store'></i> {{localize 'CARL_RPG.Item.Store.Open'}}
      </button>
    </div>
    {{/if}}{{/if}}
    <div class='item-chat-btn'>
      <button type='button' data-action='showInChat'>
        <i class='fas fa-comment'></i> {{localize 'CARL_RPG.ItemDesc.ShowInChat'}}
      </button>
    </div>
  </div>
</header>