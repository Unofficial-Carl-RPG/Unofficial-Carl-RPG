{{! Attributes Tab (Species) }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  <div class='resource'>
    <label class='resource-label' for='system.identifier'>{{localize 'CARL_RPG.Item.base.FIELDS.identifier.label'}}</label>
    <input type='text' name='system.identifier' value='{{system.identifier}}' />
  </div>

  <div class='resource'>
    <label class='resource-label' for='system.size'>{{localize 'CARL_RPG.Item.Species.FIELDS.size.label'}}</label>
    <select name='system.size'>
      {{selectOptions sizeOptions selected=system.size}}
    </select>
    <p class='hint'>{{localize 'CARL_RPG.Item.Species.SizeHint'}}</p>
  </div>
</section>
