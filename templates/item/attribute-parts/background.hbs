{{! Attributes Tab (Background) }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  <div class='resource'>
    <label class='resource-label' for='system.identifier'>{{localize 'CARL_RPG.Item.base.FIELDS.identifier.label'}}</label>
    <input type='text' name='system.identifier' value='{{system.identifier}}' />
  </div>

  {{! The creation categories this background is offered in }}
  <div class='resource tag-editor'>
    <label class='resource-label'>{{localize 'CARL_RPG.Item.Background.FIELDS.categories.label'}}</label>
    <div class='tag-options'>
      {{#each categoryOptions as |category|}}
        <label class='event-option'>
          <input
            type='checkbox'
            class='category-toggle'
            data-category='{{category.id}}'
            {{checked category.checked}}
            {{#unless @root.editable}}disabled{{/unless}}
          />
          {{localize category.label}}
        </label>
      {{/each}}
    </div>
  </div>

  {{#each backgroundWarnings as |warning|}}
    <p class='loot-warning'><i class='fas fa-triangle-exclamation'></i> {{localize warning}}</p>
  {{/each}}
</section>
