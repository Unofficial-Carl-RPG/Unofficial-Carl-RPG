{{! Attributes Tab (Skill) }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  <div class='resource'>
    <label class='resource-label' for='system.identifier'>{{localize 'CARL_RPG.Item.base.FIELDS.identifier.label'}}</label>
    <input type='text' name='system.identifier' value='{{system.identifier}}' />
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.check.target'>{{localize 'CARL_RPG.Check.Label'}}</label>
    <select name='system.check.target'>
      {{selectOptions config.checkTargets selected=system.check.target localize=true}}
    </select>
    <p class='hint'>{{localize 'CARL_RPG.Check.Hint'}}</p>
    {{#if effective.targetChanged}}
      <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowTarget' value=(localize effective.target)}}</p>
    {{/if}}
  </div>
  <div class='resource'>
    <label class='resource-label' for='system.damage'>{{localize 'CARL_RPG.Item.base.FIELDS.damage.label'}}</label>
    <input type='text' name='system.damage' value='{{system.damage}}' placeholder='1d6+@str.mod' />
      <div class='damage-extra'>
        <label class='resource-label' for='system.damageType'>{{localize 'CARL_RPG.Damage.Type'}}</label>
        <select name='system.damageType'>
          {{selectOptions @root.damageTypeOptions selected=system.damageType}}
        </select>
        <label class='resource-label' for='system.damageTypeAlso'>{{localize 'CARL_RPG.Damage.Also'}}</label>
        <select name='system.damageTypeAlso' data-tooltip='{{localize "CARL_RPG.Damage.AlsoHint"}}'>
          {{selectOptions @root.damageTypeOptions selected=system.damageTypeAlso}}
        </select>
        <label class='damage-pierce'>
          <input type='checkbox' name='system.armorPiercing' {{checked system.armorPiercing}} />
          {{localize 'CARL_RPG.Damage.ArmorPiercing'}}
        </label>
      </div>
    <p class='hint'>{{localize 'CARL_RPG.Attack.DamageHint'}}</p>
    {{#if effective.damageChanged}}
      <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowDamage' value=effective.damage}}</p>
    {{/if}}
  </div>
  {{#if effective.rankChanged}}
    <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{#if effective.rankMin}}{{localize 'CARL_RPG.Upgrades.NowRankMin' value=effective.rank min=effective.rankMin}}{{else}}{{localize 'CARL_RPG.Upgrades.NowRank' value=effective.rank}}{{/if}}</p>
  {{/if}}
  {{#if effective.rollBonus}}
    <p class='upgrade-now'><i class='fas fa-arrow-up'></i> {{localize 'CARL_RPG.Upgrades.NowRollBonus' value=(numberFormat effective.rollBonus decimals=0 sign=true)}}</p>
  {{/if}}
  {{! Rank is per character, so it only shows on skills that are on an actor }}
  <div class='grid grid-{{#if item.isEmbedded}}3{{else}}2{{/if}}col'>
    {{#if item.isEmbedded}}
      <div class='resource'>
        {{! A pet's skills use the current floor in place of a rank }}
        {{#if rankIsFloor}}
          <label class='resource-label'>{{localize 'CARL_RPG.Pets.Floor'}}</label>
          <input type='number' value='{{system.rank}}' disabled />
        {{else}}
          <label class='resource-label' for='system.rank'>{{localize 'CARL_RPG.Item.Skill.FIELDS.rank.label'}}</label>
          <input
            type='number'
            name='system.rank'
            value='{{system.rank}}'
            step='1'
            min='0'
          />
        {{/if}}
      </div>
    {{/if}}
    <div class='resource'>
      <label class='resource-label' for='system.stat'>{{localize 'CARL_RPG.Item.Skill.FIELDS.stat.label'}}</label>
      <select name='system.stat'>
        {{selectOptions config.abilities selected=system.stat localize=true}}
      </select>
    </div>
    {{! A passive skill doesn't use an action when it is used }}
    <div class='resource' data-tooltip='{{localize "CARL_RPG.Item.Skill.PassiveHint"}}'>
      <label class='resource-label' for='system.passive'>{{localize 'CARL_RPG.Item.Skill.FIELDS.passive.label'}}</label>
      <input
        type='checkbox'
        name='system.passive'
        {{checked system.passive}}
      />
    </div>
  </div>
  {{! Usage limits }}
  {{> "systems/carl-rpg/templates/item/uses-fields.hbs"}}
  {{> "systems/carl-rpg/templates/item/costs-fields.hbs"}}
  {{> "systems/carl-rpg/templates/item/targeting.hbs"}}
  <div class='resource'>
    <label class='resource-label' data-tooltip='{{localize "CARL_RPG.Combat.InterruptHint"}}'>
      <input type='checkbox' name='system.interrupt' {{#if system.interrupt}}checked{{/if}}{{#unless @root.editable}} disabled{{/unless}} />
      {{localize 'CARL_RPG.Combat.InterruptLabel'}}
    </label>
  </div>
  {{! A Damage Effect: chosen before rolling to hit with one of the attack skills it lists }}
  <div class='resource'>
    <label class='resource-label' data-tooltip='{{localize "CARL_RPG.DamageEffect.Hint"}}'>
      <input type='checkbox' name='system.damageEffect.enabled' {{checked system.damageEffect.enabled}}{{#unless @root.editable}} disabled{{/unless}} />
      {{localize 'CARL_RPG.DamageEffect.Label'}}
    </label>
    {{#if system.damageEffect.enabled}}
      <input
        type='text'
        name='system.damageEffect.skills'
        value='{{system.damageEffect.skills}}'
        placeholder='{{localize "CARL_RPG.DamageEffect.SkillsPlaceholder"}}'
      />
      {{#if damageEffectState.running}}
        <p class='upgrade-now'>
          <i class='fas fa-hourglass-half'></i>
          {{#if damageEffectState.hours}}{{localize 'CARL_RPG.DamageEffect.HoursLeft' hours=damageEffectState.hours}}{{else}}{{localize 'CARL_RPG.DamageEffect.RoundLeft'}}{{/if}}
          {{#if @root.editable}}<a class='event-add' data-action='resetCooldown'>{{localize 'CARL_RPG.DamageEffect.Reset'}}</a>{{/if}}
        </p>
      {{/if}}
    {{/if}}
  </div>
  {{! A Roll Modifier: changes the rolls of the skills it lists (Rank, damage dice, DR) }}
  <div class='resource'>
    <label class='resource-label' data-tooltip='{{localize "CARL_RPG.RollMod.Hint"}}'>
      <input type='checkbox' name='system.rollMod.enabled' {{checked system.rollMod.enabled}}{{#unless @root.editable}} disabled{{/unless}} />
      {{localize 'CARL_RPG.RollMod.Label'}}
    </label>
    {{#if system.rollMod.enabled}}
      <input
        type='text'
        name='system.rollMod.skills'
        value='{{system.rollMod.skills}}'
        placeholder='{{localize "CARL_RPG.RollMod.SkillsPlaceholder"}}'
      />
    {{/if}}
  </div>
</section>
