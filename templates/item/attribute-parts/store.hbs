{{! Attributes Tab (Store): what the store sells, and its sell percentage }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  <div class='resource'>
    <label class='resource-label' for='system.sellPercent'>{{localize 'CARL_RPG.Item.Store.FIELDS.sellPercent.label'}}</label>
    <p class='hint'>{{localize 'CARL_RPG.Item.Store.SellHint'}}</p>
    <input
      type='number'
      name='system.sellPercent'
      value='{{system.sellPercent}}'
      min='0'
      max='100'
      step='1'
      data-dtype='Number'
      {{#unless editable}}disabled{{/unless}}
    />
  </div>

  <div class='resource'>
    <label class='resource-label'>{{localize 'CARL_RPG.Item.Store.FIELDS.listings.label'}}</label>
    <p class='hint'>{{localize 'CARL_RPG.Item.Store.ListingsHint'}}</p>
    <ol class='items-list store-list'>
      <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Name'}}</div>
        <div class='item-prop'>{{localize 'CARL_RPG.Item.Store.Price'}}</div>
        <div class='item-prop'>{{localize 'CARL_RPG.Item.Store.StartStock'}}</div>
        <div class='item-prop'>{{localize 'CARL_RPG.Item.Store.Stock'}}</div>
        <div class='item-controls'></div>
      </li>
      {{#each listingRows as |row|}}
        <li class='item flexrow store-row {{#if row.missing}}missing{{/if}}' data-index='{{row.index}}'>
          <div class='item-name'>
            <div class='item-image'>
              <img src='{{row.img}}' data-item-tip='{{row.uuid}}' width='24' height='24' />
            </div>
            <div>
              {{row.name}}
              {{#if row.missing}}<em>({{localize 'CARL_RPG.Loot.Missing'}})</em>{{/if}}
            </div>
          </div>
          <div class='item-prop'>
            <input
              class='store-price'
              type='number'
              value='{{row.price}}'
              placeholder='{{row.value}}'
              min='0'
              step='1'
              {{#unless @root.editable}}disabled{{/unless}}
            />
          </div>
          <div class='item-prop'>
            <input
              class='store-quantity'
              type='number'
              value='{{row.startStock}}'
              placeholder='{{localize "CARL_RPG.Item.Store.Unlimited"}}'
              min='0'
              step='1'
              {{#unless @root.editable}}disabled{{/unless}}
            />
          </div>
          <div class='item-prop'>{{row.current}}</div>
          <div class='item-controls'>
            {{#if @root.isGM}}
              <a
                class='item-control'
                data-action='restockListing'
                data-tooltip='{{localize "CARL_RPG.Item.Store.Restock"}}'
              >
                <i class='fas fa-boxes-stacked'></i>
              </a>
            {{/if}}
            {{#if @root.editable}}
              <a
                class='item-control item-delete'
                data-action='removeListing'
                data-tooltip='{{localize "CARL_RPG.Item.Store.Remove"}}'
              >
                <i class='fas fa-trash'></i>
              </a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ol>
    {{#if editable}}
      <div class='drop-box'><i class='fas fa-plus'></i> {{localize 'CARL_RPG.Drop.store'}}</div>
    {{/if}}
  </div>
</section>
