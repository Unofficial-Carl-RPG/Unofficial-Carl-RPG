{{! Attributes Tab (Club) }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  {{#if isCopy}}
    {{! A crawler's copy: its own rank or role in the club }}
    <div class='resource'>
      <label class='resource-label' for='system.role'>{{localize 'CARL_RPG.Item.Club.FIELDS.role.label'}}</label>
      <input type='text' name='system.role' value='{{system.role}}' placeholder='{{localize "CARL_RPG.Item.Club.RolePlaceholder"}}' />
    </div>
  {{else}}
    {{! The world club: who is in it }}
    <div class='resource'>
      <label class='resource-label'>{{localize 'CARL_RPG.Item.Club.Members'}}</label>
      {{#each clubMembers as |member|}}
        <div class='club-member'>
          <span>{{member.name}}</span>
          {{#if member.role}}<span class='hint'>{{member.role}}</span>{{/if}}
        </div>
      {{else}}
        <p class='hint'>{{localize 'CARL_RPG.Item.Club.NoMembers'}}</p>
      {{/each}}
    </div>
  {{/if}}
</section>
