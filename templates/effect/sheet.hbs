{{! Effect sheet }}
<div class='effect-sheet'>
  <header class='effect-header'>
    <img
      class='profile-img'
      src='{{effect.img}}'
      data-edit='img'
      data-action='editImage'
      data-tooltip='{{effect.name}}'
      width='64'
      height='64'
    />
    <input
      class='effect-name'
      name='name'
      type='text'
      value='{{effect.name}}'
      placeholder='{{localize "CARL_RPG.Effect.Name"}}'
    />
  </header>

  <div class='grid grid-2col'>
    <div class='resource'>
      <label class='resource-label' for='flags.carl-rpg.kind'>{{localize 'CARL_RPG.Effect.Type'}}</label>
      <select name='flags.carl-rpg.kind'>
        {{selectOptions kinds selected=kind localize=true}}
      </select>
    </div>
    <div class='resource'>
      <label class='resource-label' for='flags.carl-rpg.identifier'>{{localize 'CARL_RPG.Item.base.FIELDS.identifier.label'}}</label>
      <input
        type='text'
        name='flags.carl-rpg.identifier'
        value='{{flags.identifier}}'
      />
    </div>
  </div>

  <div class='resource'>
    <label class='resource-label' for='flags.carl-rpg.lastsUntil'>{{localize 'CARL_RPG.Rest.Lasts'}}</label>
    <select name='flags.carl-rpg.lastsUntil'>
      {{selectOptions durations selected=lastsUntil localize=true}}
    </select>
  </div>

  {{! A number of rounds: counted down at the end of each round once it is on }}
  <div class='resource'>
    <label class='resource-label' for='flags.carl-rpg.rounds'>{{localize 'CARL_RPG.Effect.Rounds'}}</label>
    <input
      type='number'
      name='flags.carl-rpg.rounds'
      value='{{rounds}}'
      min='0'
      step='1'
      placeholder='{{localize "CARL_RPG.Effect.NoLimit"}}'
    />
    {{#if roundsLeft}}
      <p class='upgrade-now'>{{localize 'CARL_RPG.Effect.RoundsLeft' count=roundsLeft}}</p>
    {{/if}}
  </div>

  {{#if isDebuff}}
    <div class='grid grid-2col'>
      <div class='resource'>
        <label class='resource-label' for='flags.carl-rpg.stackable'>{{localize 'CARL_RPG.Effect.Stackable'}}</label>
        <input
          type='checkbox'
          name='flags.carl-rpg.stackable'
          {{checked flags.stackable}}
        />
      </div>
      {{#if flags.stackable}}
        <div class='resource'>
          <label class='resource-label' for='flags.carl-rpg.maxStacks'>{{localize 'CARL_RPG.Effect.MaxStacks'}}</label>
          <input
            type='number'
            name='flags.carl-rpg.maxStacks'
            value='{{flags.maxStacks}}'
            min='1'
            step='1'
            placeholder='{{localize "CARL_RPG.Effect.NoLimit"}}'
          />
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{#if isBuff}}
    <div class='grid grid-2col'>
      <div class='resource'>
        <label
          class='resource-label'
          for='flags.carl-rpg.stackBuff'
          data-tooltip='{{localize "CARL_RPG.Effect.StackBuffTip"}}'
        >{{localize 'CARL_RPG.Effect.StackBuff'}}</label>
        <input
          type='checkbox'
          name='flags.carl-rpg.stackBuff'
          {{checked flags.stackBuff}}
        />
      </div>
      {{#if flags.stackBuff}}
        <div class='resource'>
          <label class='resource-label' for='flags.carl-rpg.stackAs'>{{localize 'CARL_RPG.Effect.StackAs'}}</label>
          <input
            type='text'
            name='flags.carl-rpg.stackAs'
            value='{{flags.stackAs}}'
            placeholder='{{effect.name}}'
          />
        </div>
      {{/if}}
    </div>
  {{/if}}

  <div class='resource effect-options'>
    <label>
      <input
        type='checkbox'
        name='flags.carl-rpg.permanent'
        {{checked flags.permanent}}
      />
      {{localize 'CARL_RPG.Effect.Permanent'}}
    </label>
    {{#if canEquipLink}}
      <label>
        <input
          type='checkbox'
          name='flags.carl-rpg.equipLinked'
          {{checked flags.equipLinked}}
        />
        {{localize 'CARL_RPG.Effect.EquipLinked'}}
      </label>
    {{/if}}
  </div>

  <div class='effect-modifiers'>
    <h3>{{localize 'CARL_RPG.Effect.Modifiers'}}</h3>
    {{#each modifiers as |mod|}}
      <div class='modifier-row' data-index='{{mod.index}}'>
        <select class='modifier-stat'>
          {{selectOptions @root.modifierOptions selected=mod.stat localize=true}}
        </select>
        <input
          class='modifier-value'
          type='number'
          value='{{mod.value}}'
          step='1'
        />
        {{#if @root.editable}}
          <a class='item-control' data-action='removeModifier' data-tooltip='{{localize "CARL_RPG.Effect.RemoveModifier"}}'>
            <i class='fas fa-trash'></i>
          </a>
        {{/if}}
      </div>
    {{/each}}
    {{#if editable}}
      <a class='item-control add-modifier' data-action='addModifier'>
        <i class='fas fa-plus'></i> {{localize 'CARL_RPG.Effect.AddModifier'}}
      </a>
    {{/if}}
  </div>

  {{! Build benefits that need something picked }}
  <div class='effect-modifiers'>
    <h3>{{localize 'CARL_RPG.Build.Section'}}</h3>
    {{#if skillTagNames.length}}
      <datalist id='carl-skill-tags'>
        {{#each skillTagNames as |name|}}<option value='{{name}}'></option>{{/each}}
      </datalist>
    {{/if}}
    {{#each buildMods as |mod|}}
      <div class='modifier-row build-mod-row' data-index='{{mod.index}}'>
        <select class='build-mod-kind'>
          {{selectOptions @root.buildKindOptions selected=mod.kind localize=true}}
        </select>
        {{#if mod.isScoped}}
          {{! Skill cap: which skills and spells it covers }}
          <select class='build-mod-target'>
            {{selectOptions @root.skillCapScopeOptions selected=mod.target localize=true}}
          </select>
          {{#if mod.scopeSkill}}
            <input type='hidden' class='build-mod-value' value='{{mod.value}}' />
            <input type='hidden' class='build-mod-name' value='{{mod.name}}' />
            {{#if mod.value}}
              <div class='build-drop' data-build-index='{{mod.index}}'>
                <span class='drop-name'>{{#if mod.name}}{{mod.name}}{{else}}{{mod.value}}{{/if}}</span>
                {{#if @root.editable}}
                  <a class='item-control' data-action='clearBuildSkill'><i class='fas fa-xmark'></i></a>
                {{/if}}
              </div>
            {{else}}
              {{#if @root.editable}}
                <div class='build-drop' data-build-index='{{mod.index}}'>
                  <span class='drop-hint'>{{localize 'CARL_RPG.Build.DropSkill'}}</span>
                </div>
              {{/if}}
            {{/if}}
          {{/if}}
          {{#if mod.scopeTag}}
            <input class='build-mod-value build-tag' type='text' list='carl-skill-tags' value='{{mod.value}}' placeholder='{{localize "CARL_RPG.Tags.Placeholder"}}' />
          {{/if}}
          {{#if mod.scopePick}}
            {{! The player picks N skills, from those matching a tag, stat and kind }}
            <input class='build-mod-count' type='number' min='1' step='1' value='{{mod.count}}' data-tooltip='{{localize "CARL_RPG.Picks.CountHint"}}' />
            <input class='build-mod-pick-tag build-tag' type='text' list='carl-skill-tags' value='{{mod.tag}}' placeholder='{{localize "CARL_RPG.Tags.Placeholder"}}' />
            <select class='build-mod-pick-stat'>
              {{selectOptions @root.pickStatOptions selected=mod.stat localize=true}}
            </select>
            <select class='build-mod-pick-kind'>
              {{selectOptions @root.pickKindOptions selected=mod.skillKind localize=true}}
            </select>
            {{#if mod.pickedNames}}<div class='build-picked'>{{localize 'CARL_RPG.Picks.Picked'}}: {{mod.pickedNames}}</div>{{/if}}
          {{/if}}
          {{#if mod.hasAmount}}
            <input class='build-mod-amount' type='number' step='1' value='{{mod.amount}}' data-tooltip='{{localize "CARL_RPG.Build.Amount"}}' />
          {{/if}}
          {{#if mod.isDice}}
            {{! Bonus damage dice: dice, an optional damage type (and a second), and when it applies }}
            <input class='build-mod-dice' type='text' value='{{mod.dice}}' placeholder='1d4' data-tooltip='{{localize "CARL_RPG.Build.DiceHint"}}' />
            <select class='build-mod-bonus-type' data-tooltip='{{localize "CARL_RPG.Upgrades.BonusType.Hint"}}'>
              {{selectOptions @root.bonusTypeOptions selected=mod.bonusType}}
            </select>
            {{#if mod.bonusType}}
              <select class='build-mod-bonus-also' data-tooltip='{{localize "CARL_RPG.Upgrades.BonusType.AlsoHint"}}'>
                {{selectOptions @root.bonusAlsoOptions selected=mod.bonusAlso}}
              </select>
            {{/if}}
            <select class='build-mod-when' data-tooltip='{{localize "CARL_RPG.RollMod.WhenHint"}}'>
              {{selectOptions @root.diceWhenOptions selected=mod.when localize=true}}
            </select>
            {{#if mod.isWithin}}
              <input class='build-mod-feet' type='number' min='1' step='any' value='{{mod.feet}}' placeholder='{{localize "CARL_RPG.RollMod.WithinPlaceholder"}}' data-tooltip='{{localize "CARL_RPG.RollMod.WithinHint"}}' />
            {{/if}}
          {{/if}}
          {{#if mod.isSwap}}
            {{! Damage stat: the stat modifier a damage formula adds is swapped for another }}
            <select class='build-mod-from' data-tooltip='{{localize "CARL_RPG.Build.SwapFrom"}}'>
              {{selectOptions @root.statOptions selected=mod.from localize=true}}
            </select>
            <i class='fas fa-arrow-right'></i>
            <select class='build-mod-to' data-tooltip='{{localize "CARL_RPG.Build.SwapTo"}}'>
              {{selectOptions @root.statOptions selected=mod.to localize=true}}
            </select>
          {{/if}}
          {{#if mod.invalid}}
            <i class='fas fa-triangle-exclamation upgrade-invalid' data-tooltip='{{localize "CARL_RPG.Upgrades.Invalid"}}'></i>
          {{/if}}
        {{else if mod.isSplit}}
          {{! Points the player splits between stats }}
          <input class='build-mod-points' type='number' min='1' step='1' value='{{mod.points}}' data-tooltip='{{localize "CARL_RPG.Picks.PointsHint"}}' />
          <div class='build-stat-boxes'>
            {{#each mod.statBoxes as |box|}}
              <label class='build-stat-box-label'>
                <input type='checkbox' class='build-mod-stat-box' value='{{box.key}}' {{checked box.checked}} />
                {{localize box.label}}
              </label>
            {{/each}}
          </div>
          <select class='build-mod-repick'>
            {{selectOptions @root.repickOptions selected=mod.repick localize=true}}
          </select>
          {{#if mod.splitText}}<div class='build-picked'>{{localize 'CARL_RPG.Picks.Picked'}}: {{mod.splitText}}</div>{{/if}}
        {{else}}
          <select class='build-mod-target'>
            {{selectOptions @root.buildTargetOptions selected=mod.target localize=true}}
          </select>
          <input class='build-mod-value' type='text' value='{{mod.value}}' placeholder='{{localize "CARL_RPG.Build.Value"}}' />
        {{/if}}
        {{#if @root.editable}}
          <a class='item-control' data-action='removeBuildMod' data-tooltip='{{localize "CARL_RPG.Build.Remove"}}'>
            <i class='fas fa-trash'></i>
          </a>
        {{/if}}
      </div>
    {{/each}}
    {{#if editable}}
      <a class='item-control add-modifier' data-action='addBuildMod'>
        <i class='fas fa-plus'></i> {{localize 'CARL_RPG.Build.Add'}}
      </a>
    {{/if}}
  </div>

  {{! What the effect does to damage types }}
  <div class='effect-modifiers'>
    <h3>{{localize 'CARL_RPG.Damage.Section'}}</h3>
    {{#each damageMods as |mod|}}
      <div class='modifier-row damage-mod-row' data-index='{{mod.index}}'>
        <select class='damage-mod-mode'>
          {{selectOptions @root.damageModeOptions selected=mod.mode localize=true}}
        </select>
        <select class='damage-mod-type'>
          {{selectOptions @root.damageTypeOptions selected=mod.type}}
        </select>
        {{#if @root.editable}}
          <a class='item-control' data-action='removeDamageMod' data-tooltip='{{localize "CARL_RPG.Damage.RemoveMod"}}'>
            <i class='fas fa-trash'></i>
          </a>
        {{/if}}
      </div>
    {{/each}}
    {{#if editable}}
      <a class='item-control add-modifier' data-action='addDamageMod'>
        <i class='fas fa-plus'></i> {{localize 'CARL_RPG.Damage.AddMod'}}
      </a>
    {{/if}}
  </div>

  {{! Events that run while the effect is on }}
  <div class='effect-events'>
    <h3>{{localize 'CARL_RPG.Effect.Events'}}</h3>
    {{#if eventsUnapproved}}
      <p class='loot-warning'>
        <i class='fas fa-triangle-exclamation'></i> {{localize 'CARL_RPG.Events.NotTrusted'}}
        {{#if isGM}}
          <a class='event-add' data-action='approveEvents'>{{localize 'CARL_RPG.Events.Approve'}}</a>
        {{/if}}
      </p>
    {{/if}}
    {{> "systems/carl-rpg/templates/item/event-cards.hbs" rows=eventRows list='events'}}
  </div>

  <div class='effect-description'>
    <h3>{{localize 'CARL_RPG.Effect.Description'}}</h3>
    {{#if editable}}
      <prose-mirror
        name='description'
        data-document-uuid='{{effect.uuid}}'
        value='{{effect.description}}'
        toggled='true'
      >
        {{{enrichedDescription}}}
      </prose-mirror>
    {{else}}
      {{{enrichedDescription}}}
    {{/if}}
  </div>
</div>
