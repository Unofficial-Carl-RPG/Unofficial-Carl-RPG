<section class='store-window-body'>
  <p class='store-gold'>{{localize 'CARL_RPG.Actor.Crawler.Gold'}}: {{gold}}</p>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'Name'}}</div>
      <div class='item-prop'>{{localize 'CARL_RPG.Item.Store.Price'}}</div>
      <div class='item-prop'>{{localize 'CARL_RPG.Item.Store.Quantity'}}</div>
      <div class='item-controls'></div>
    </li>
    {{#each rows as |row|}}
      <li class='item flexrow store-row' data-index='{{row.index}}'>
        <div class='item-name'>
          <div class='item-image'>
            <img src='{{row.img}}' data-tooltip='{{row.name}}' width='24' height='24' />
          </div>
          <div>{{row.name}}</div>
        </div>
        <div class='item-prop'>{{row.price}}</div>
        <div class='item-prop'>{{row.stockLabel}}</div>
        <div class='item-controls'>
          <button type='button' data-action='buy' {{#if row.unavailable}}disabled{{/if}}>
            {{#if row.unavailable}}{{localize 'CARL_RPG.Item.Store.SoldOut'}}{{else}}{{localize 'CARL_RPG.Item.Store.Buy'}}{{/if}}
          </button>
        </div>
      </li>
    {{/each}}
  </ol>
</section>
